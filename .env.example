# ═══════════════════════════════════════════════════════════════
# Beulrock - Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control!
# ═══════════════════════════════════════════════════════════════

# ── Application ──
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://salbjork.web.id
NEXT_PUBLIC_APP_NAME=Beulrock
NEXT_PUBLIC_WS_URL=wss://salbjork.web.id

# ── Database (Supabase PostgreSQL) ──
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Auth (JWT) ──
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-min-32-chars

# ── Supabase (Auth + Client) ──
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Resend (Email Verification) ──
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@salbjork.web.id
EMAIL_FROM_NAME=Beulrock

# ── Upstash Redis (Caching + Rate Limiting) ──
UPSTASH_REDIS_REST_URL=https://[YOUR-UPSTASH-INSTANCE].upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# Alternative: Direct Redis URL
REDIS_URL=redis://default:[PASSWORD]@[YOUR-UPSTASH-ENDPOINT]:6379

# ── Cloudflare Workers ──
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_WORKERS_KV_NAMESPACE_ID=your-kv-namespace-id
CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id

# ── WebSocket Server (only for self-hosted, not Vercel) ──
WS_PORT=3033

# ── Server Linker Protocol ──
LINKER_SECRET=beulrock_linker_hmac_secret_key_2024
LINKER_BASE_URL=https://linker.beulrock.internal
LINKER_MODE=demo

# ── C++ Engine ──
ENGINE_PATH=./core-engine/bin/beulrock-engine

# ── Admin (Seed) ──
ADMIN_EMAIL=admin@beulrock.com
ADMIN_PASSWORD=change-this-password
